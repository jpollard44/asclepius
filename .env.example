# Copy this file to .env and fill in your key, or export these in your shell.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the advisor (defaults to claude-opus-4-8).
# ASCLEPIUS_MODEL=claude-opus-4-8

# Optional: where the parsed health database is stored (defaults to ./data/health.db).
# ASCLEPIUS_DB=./data/health.db

# Web push (VAPID) keys for PWA notifications. Generate your own pair with:
#   ./.venv/bin/python scripts/gen_vapid.py
# Leave these blank to run with push disabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Multi-tenant service mode (the public iOS app backend). Leave everything
# below unset for the private local app.
# ---------------------------------------------------------------------------
# Enable accounts, per-user databases, and required auth on the API.
# ASCLEPIUS_MULTI_TENANT=1

# Secret for signing session tokens. Generate with: openssl rand -base64 48
# (If unset, one is generated and persisted under ./data/secret.key.)
# ASCLEPIUS_SECRET=

# The iOS app's bundle identifier (Sign in with Apple audience + APNs topic).
# ASCLEPIUS_APPLE_BUNDLE_ID=com.asclepius.app

# Per-user daily budget of coach turns (chat/briefing/photo analysis).
# ASCLEPIUS_CHAT_DAILY_LIMIT=60

# Email-only login for development and simulators. NEVER enable in production.
# ASCLEPIUS_DEV_LOGIN=1

# APNs push (token-based auth). Create a key in the Apple Developer portal
# under Certificates, Identifiers & Profiles > Keys. APNS_KEY is the .p8 file
# path or its PEM contents.
# APNS_KEY=./AuthKey_ABC123DEFG.p8
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=YOURTEAMID
# APNS_TOPIC=com.asclepius.app
